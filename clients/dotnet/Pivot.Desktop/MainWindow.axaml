<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Pivot.Desktop.MainWindow"
        xmlns:sheet="clr-namespace:Pivot.Avalonia;assembly=Pivot.Avalonia"
        Width="1080" Height="760" MinWidth="1040" MinHeight="700"
        Title="Pivot">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="New" Click="NewClick" />
        <Button Content="Open…" Click="OpenClick" />
        <Button Content="Save" Click="SaveClick" />
        <Button Content="Save As…" Click="SaveAsClick" />
        <Button Content="Close workbook" Click="CloseDocumentClick" />
        <Menu VerticalAlignment="Center">
          <MenuItem Header="CSV">
            <MenuItem Header="Import CSV…" Click="ImportCsvClick" />
            <MenuItem Header="Export CSV…" Click="ExportCsvClick" />
          </MenuItem>
        </Menu>
        <Menu VerticalAlignment="Center">
          <MenuItem x:Name="StructureRoot" Header="_Edit" SubmenuOpened="StructureOpened">
            <MenuItem x:Name="InsertRowsItem" Header="Insert rows above" Click="InsertRowsClick" />
            <MenuItem x:Name="DeleteRowsItem" Header="Delete entire rows" Click="DeleteRowsClick" />
            <MenuItem x:Name="InsertColumnsItem" Header="Insert columns left" Click="InsertColumnsClick" />
            <MenuItem x:Name="DeleteColumnsItem" Header="Delete entire columns" Click="DeleteColumnsClick" />
            <Separator />
            <MenuItem Header="Section geometry…" Click="GeometryClick" />
            <MenuItem Header="Grid zoom">
              <MenuItem x:Name="GeometryZoom25" Header="25%" Tag="25" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom50" Header="50%" Tag="50" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom75" Header="75%" Tag="75" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom100" Header="100%" Tag="100" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom125" Header="125%" Tag="125" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom200" Header="200%" Tag="200" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom400" Header="400%" Tag="400" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom800" Header="800%" Tag="800" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom1600" Header="1600%" Tag="1600" Click="GeometryZoomClick" />
              <MenuItem x:Name="GeometryZoom3200" Header="3200%" Tag="3200" Click="GeometryZoomClick" />
            </MenuItem>

            <MenuItem Header="Select row(s) across the whole scope" Click="WholeScopeRowsClick" />
            <MenuItem Header="Select column(s) across the whole scope" Click="WholeScopeColumnsClick" />
            <MenuItem x:Name="SortItem" Header="_Sort selected range…" Click="SortClick" />
            <MenuItem x:Name="CopyVisibleItem" Header="Copy Visible Cells" Click="CopyVisibleClick" />
            <MenuItem x:Name="PasteVisibleItem" Header="Paste into Visible Rows…" Click="PasteVisibleClick" />
            <MenuItem x:Name="ClearVisibleRoot" Header="Clear Visible Cells">
              <MenuItem Header="Clear Visible Contents…" Tag="Contents" Click="ClearVisibleClick" />
              <MenuItem Header="Clear Visible Formatting (Built-in Defaults)…" Tag="Formatting" Click="ClearVisibleClick" />
              <MenuItem Header="Clear Visible Contents and Formatting…" Tag="Both" Click="ClearVisibleClick" />
            </MenuItem>
            <MenuItem x:Name="FillVisibleRoot" Header="Fill Visible Cells">
              <MenuItem Header="Down…" Tag="Down" Click="FillVisibleClick" />
              <MenuItem Header="Up…" Tag="Up" Click="FillVisibleClick" />
              <MenuItem Header="Right…" Tag="Right" Click="FillVisibleClick" />
              <MenuItem Header="Left…" Tag="Left" Click="FillVisibleClick" />
            </MenuItem>
            <MenuItem x:Name="FilterItem" Header="_Filter records…" Click="FilterClick" />
          </MenuItem>
        </Menu>
        <Button x:Name="CopyCellsButton" Content="Copy" Click="CopyClick" ToolTip.Tip="Copy selected text, or the selected rectangle (up to 256 cells)" />
        <Button x:Name="PasteCellsButton" Content="Paste" Click="PasteClick" ToolTip.Tip="Paste text into the editor or atomically paste a rectangle" />
        <Menu VerticalAlignment="Center">
          <MenuItem x:Name="FillRoot" Header="_Fill" SubmenuOpened="FillOpened">
            <MenuItem x:Name="FillDownItem" Header="Fill _Down" Tag="Down" Click="FillClick" />
            <MenuItem x:Name="FillUpItem" Header="Fill _Up" Tag="Up" Click="FillClick" />
            <MenuItem x:Name="FillRightItem" Header="Fill _Right" Tag="Right" Click="FillClick" />
            <MenuItem x:Name="FillLeftItem" Header="Fill _Left" Tag="Left" Click="FillClick" />
          </MenuItem>
        </Menu>
        <CheckBox x:Name="BlinkCaret" Content="Blink caret" IsChecked="True" IsCheckedChanged="CaretOptionChanged" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="ProofPanel" IsVisible="False" Spacing="5">
        <TextBlock Text="Experimental projection document — in memory, cannot save" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Publish empty" Tag="0" Click="ProofPublishClick" />
          <Button Content="Publish 3" Tag="3" Click="ProofPublishClick" />
          <Button Content="Publish 5" Tag="5" Click="ProofPublishClick" />
          <Button Content="Remove L2" Click="ProofRemoveClick" />
          <Button Content="Reverse view" Click="ProofReverseClick" />
          <Button Content="Move view" Click="ProofMoveClick" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="BindingPanel" IsVisible="False" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Private binding proof: =@{InvoiceLines.TotalAmount}*1.1" />
        <Button Content="Unavailable" Click="BindingUnavailableClick" />
        <Button Content="Rename source" Click="BindingRenameClick" />
        <Button Content="Duplicate to B12" Click="BindingDuplicateClick" />
      </StackPanel>
      <StackPanel x:Name="FilterBar" IsVisible="False" Spacing="5">
        <TextBlock x:Name="FilterStatusLabel" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Review filter…" Click="FilterClick" />
          <Button x:Name="ReapplyFilterButton" Content="Reapply" Click="ReapplyFilterClick" />
          <Button x:Name="ClearFilterButton" Content="Clear Filter" Click="ClearFilterClick" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="GeometryLayoutBar" IsVisible="False" Spacing="5">
        <TextBlock x:Name="GeometryLayoutStatus" TextWrapping="Wrap" />
        <StackPanel x:Name="GeometryLayoutReviewActions" IsVisible="False" Orientation="Horizontal" Spacing="8">
          <Button Content="Review positional geometry…" Click="GeometryClick" />
          <Button Content="Keep positional settings" Click="KeepGeometryLayoutClick" />
          <Button Content="Reset positional geometry" Click="ResetGeometryLayoutClick" />
        </StackPanel>
      </StackPanel>
      <TextBlock Text="Pivot" FontSize="22" FontWeight="Bold" />
      <Grid x:Name="WorksheetBar" ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="6">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="WorksheetTabs" Orientation="Horizontal" Spacing="3" /></ScrollViewer>
        <Button x:Name="AddWorksheetButton" Grid.Column="1" Content="+ Sheet" Click="AddWorksheetClick" />
        <TextBox x:Name="WorksheetNameEditor" Grid.Column="2" MaxLength="64" PlaceholderText="Worksheet name" />
        <Button x:Name="RenameWorksheetButton" Grid.Column="3" Content="Rename" Click="RenameWorksheetClick" />
      </Grid>
      <StackPanel x:Name="WindowBar" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Windows" VerticalAlignment="Center" />
          <TextBox x:Name="WindowNameEditor" Width="150" MaxLength="64" PlaceholderText="Window name" />
          <TextBlock Text="Rows" VerticalAlignment="Center" /><NumericUpDown x:Name="WindowRows" Minimum="1" Maximum="65536" Value="65536" Width="95" />
          <TextBlock Text="Columns" VerticalAlignment="Center" /><NumericUpDown x:Name="WindowColumns" Minimum="1" Maximum="1024" Value="1024" Width="85" />
          <Button x:Name="CreateWindowButton" Content="Create" Click="CreateWindowClick" />
          <Button x:Name="RenameWindowButton" Content="Rename" Click="RenameWindowClick" />
          <Button x:Name="DeleteWindowButton" Content="Delete…" Click="DeleteWindowClick" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button x:Name="CopyValuesButton" Content="Copy Values" Click="CopyValuesClick" Margin="0,0,6,0" />
          <Button Content="Paste Text" Click="PasteTextClick" Margin="0,0,6,0" />
          <Button x:Name="BindWindowButton" Content="Bind source…" Click="BindWindowClick" Margin="0,0,6,0" />
          <Button x:Name="BoundSourceButton" Content="Source…" Click="BoundSourceClick" Margin="0,0,6,0" />
          <Button x:Name="RefreshProducerButton" Content="Refresh" Click="RefreshProducerClick" Margin="0,0,6,0" />
          <Button x:Name="DetachWindowButton" Content="Detach copy…" Click="DetachWindowClick" />
        </WrapPanel>
        <TextBlock x:Name="BoundStatusLabel" IsVisible="False" TextWrapping="Wrap" />
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="WindowTabs" Orientation="Horizontal" Spacing="3" /></ScrollViewer>
      </StackPanel>
      <Grid ColumnDefinitions="60,*,80" ColumnSpacing="8">
        <TextBlock x:Name="AddressLabel" Text="A1" VerticalAlignment="Center" />
        <TextBox x:Name="FormulaEntry" Grid.Column="1" MaxLength="4096" PlaceholderText="Enter a number or =A1+B1" KeyDown="EntryKeyDown" />
        <Button x:Name="ClearButton" Grid.Column="2" Content="Clear" Click="ClearClick" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="↑ Rows" Click="UpClick" /><Button Content="↓ Rows" Click="DownClick" />
        <Button Content="← Columns" Click="LeftClick" /><Button Content="→ Columns" Click="RightClick" />
        <TextBox x:Name="MoveTarget" Width="100" PlaceholderText="Move to B22" />
        <Button x:Name="MoveButton" Content="Move selected" Click="MoveClick" />
      </StackPanel>
      <Expander x:Name="FormatPane" Header="Format selection" HorizontalAlignment="Stretch"><StackPanel x:Name="FormatFields" Spacing="6" /></Expander>
      <TextBlock x:Name="SelectionLabel" FontSize="11" TextWrapping="Wrap" />
      <TextBlock Text="Drag or Shift+click/arrows to select · Type to replace · F2/double-click to edit · Enter/Tab/arrows commit · Escape to cancel" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="5">
      <TextBlock x:Name="StatusLabel" Text="Starting Rust session…" TextWrapping="Wrap" />
      <TextBlock x:Name="TimingLabel" TextWrapping="Wrap" FontSize="11" />
      <TextBlock x:Name="DocumentLabel" Text="New unsaved workbook" FontSize="11" />
    </StackPanel>
    <Grid VerticalAlignment="Top">
      <sheet:WorksheetView x:Name="Sheet" />
      <Canvas x:Name="EditorLayer" IsHitTestVisible="False">
        <TextBox x:Name="CellEditor" IsVisible="False" MaxLength="4096" Padding="3,1"
                 MinHeight="26" FontSize="13" />
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
