<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Pivot.Desktop.MainWindow"
        xmlns:sheet="clr-namespace:Pivot.Avalonia;assembly=Pivot.Avalonia"
        Width="1080" Height="760" MinWidth="1040" MinHeight="700"
        Title="Pivot">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="New" Click="NewClick" />
        <Button Content="Open…" Click="OpenClick" />
        <Button Content="Save" Click="SaveClick" />
        <Button Content="Save As…" Click="SaveAsClick" />
        <Button Content="Close workbook" Click="CloseDocumentClick" />
        <Menu VerticalAlignment="Center">
          <MenuItem Header="CSV">
            <MenuItem Header="Import CSV…" Click="ImportCsvClick" />
            <MenuItem Header="Export CSV…" Click="ExportCsvClick" />
          </MenuItem>
        </Menu>
        <Menu VerticalAlignment="Center">
          <MenuItem x:Name="StructureRoot" Header="_Edit rows/columns" SubmenuOpened="StructureOpened">
            <MenuItem x:Name="InsertRowsItem" Header="Insert rows above" Click="InsertRowsClick" />
            <MenuItem x:Name="DeleteRowsItem" Header="Delete entire rows" Click="DeleteRowsClick" />
            <MenuItem x:Name="InsertColumnsItem" Header="Insert columns left" Click="InsertColumnsClick" />
            <MenuItem x:Name="DeleteColumnsItem" Header="Delete entire columns" Click="DeleteColumnsClick" />
          </MenuItem>
        </Menu>
        <Button Content="Copy" Click="CopyClick" ToolTip.Tip="Copy selected text, or the selected rectangle (up to 256 cells)" />
        <Button Content="Paste" Click="PasteClick" ToolTip.Tip="Paste text into the editor or atomically paste a rectangle" />
        <Menu VerticalAlignment="Center">
          <MenuItem x:Name="FillRoot" Header="_Fill" SubmenuOpened="FillOpened">
            <MenuItem x:Name="FillDownItem" Header="Fill _Down" Tag="Down" Click="FillClick" />
            <MenuItem x:Name="FillUpItem" Header="Fill _Up" Tag="Up" Click="FillClick" />
            <MenuItem x:Name="FillRightItem" Header="Fill _Right" Tag="Right" Click="FillClick" />
            <MenuItem x:Name="FillLeftItem" Header="Fill _Left" Tag="Left" Click="FillClick" />
          </MenuItem>
        </Menu>
        <CheckBox x:Name="BlinkCaret" Content="Blink caret" IsChecked="True" IsCheckedChanged="CaretOptionChanged" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel x:Name="ProofPanel" IsVisible="False" Spacing="5">
        <TextBlock Text="Experimental projection document — in memory, cannot save" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Publish empty" Tag="0" Click="ProofPublishClick" />
          <Button Content="Publish 3" Tag="3" Click="ProofPublishClick" />
          <Button Content="Publish 5" Tag="5" Click="ProofPublishClick" />
          <Button Content="Remove L2" Click="ProofRemoveClick" />
          <Button Content="Reverse view" Click="ProofReverseClick" />
          <Button Content="Move view" Click="ProofMoveClick" />
        </StackPanel>
      </StackPanel>
      <StackPanel x:Name="BindingPanel" IsVisible="False" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Private binding proof: =@{InvoiceLines.TotalAmount}*1.1" />
        <Button Content="Unavailable" Click="BindingUnavailableClick" />
        <Button Content="Rename source" Click="BindingRenameClick" />
        <Button Content="Duplicate to B12" Click="BindingDuplicateClick" />
      </StackPanel>
      <TextBlock Text="Pivot" FontSize="22" FontWeight="Bold" />
      <Grid x:Name="WorksheetBar" ColumnDefinitions="*,Auto,160,Auto" ColumnSpacing="6">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="WorksheetTabs" Orientation="Horizontal" Spacing="3" /></ScrollViewer>
        <Button x:Name="AddWorksheetButton" Grid.Column="1" Content="+ Sheet" Click="AddWorksheetClick" />
        <TextBox x:Name="WorksheetNameEditor" Grid.Column="2" MaxLength="64" PlaceholderText="Worksheet name" />
        <Button x:Name="RenameWorksheetButton" Grid.Column="3" Content="Rename" Click="RenameWorksheetClick" />
      </Grid>
      <Grid ColumnDefinitions="60,*,80" ColumnSpacing="8">
        <TextBlock x:Name="AddressLabel" Text="A1" VerticalAlignment="Center" />
        <TextBox x:Name="FormulaEntry" Grid.Column="1" MaxLength="4096" PlaceholderText="Enter a number or =A1+B1" KeyDown="EntryKeyDown" />
        <Button x:Name="ClearButton" Grid.Column="2" Content="Clear" Click="ClearClick" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="↑ Rows" Click="UpClick" /><Button Content="↓ Rows" Click="DownClick" />
        <Button Content="← Columns" Click="LeftClick" /><Button Content="→ Columns" Click="RightClick" />
        <TextBox x:Name="MoveTarget" Width="100" PlaceholderText="Move to B22" />
        <Button x:Name="MoveButton" Content="Move selected" Click="MoveClick" />
      </StackPanel>
      <Expander x:Name="FormatPane" Header="Format selection" HorizontalAlignment="Stretch"><StackPanel x:Name="FormatFields" Spacing="6" /></Expander>
      <TextBlock x:Name="SelectionLabel" FontSize="11" TextWrapping="Wrap" />
      <TextBlock Text="Drag or Shift+click/arrows to select · Type to replace · F2/double-click to edit · Enter/Tab/arrows commit · Escape to cancel" />
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Spacing="5">
      <TextBlock x:Name="StatusLabel" Text="Starting Rust session…" TextWrapping="Wrap" />
      <TextBlock x:Name="TimingLabel" TextWrapping="Wrap" FontSize="11" />
      <TextBlock x:Name="DocumentLabel" Text="New unsaved workbook" FontSize="11" />
    </StackPanel>
    <Grid VerticalAlignment="Top">
      <sheet:WorksheetView x:Name="Sheet" />
      <Canvas x:Name="EditorLayer" IsHitTestVisible="False">
        <TextBox x:Name="CellEditor" IsVisible="False" MaxLength="4096" Padding="3,1"
                 MinHeight="26" FontSize="13" />
      </Canvas>
    </Grid>
  </DockPanel>
</Window>
